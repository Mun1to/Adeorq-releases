{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Adeorq",
  "version": "0.9.240",
  "identifier": "com.orquio.adeorq",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Adeorq",
        "width": 1360,
        "height": 850,
        "minWidth": 940,
        "minHeight": 600,
        "maximized": true,
        "transparent": true,
        "additionalBrowserArgs": "--use-fake-ui-for-media-stream --autoplay-policy=no-user-gesture-required",
        "windowEffects": {
          "effects": [
            "acrylic",
            "hudWindow"
          ],
          "state": "active"
        }
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "media-src": "'self' asset: http://asset.localhost data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost data: blob: https://ijraewpmsgwmxmfgwwae.supabase.co",
        "frame-src": "http: https: blob:",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPLOCALDATA/**",
          "$LOCALDATA/Adeorq/**",
          "$LOCALDATA/adeorq/**"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZGQ0NEREUwNDBCQjU0Q0MKUldUTVZMdEE0TjNNLzM1MDlLcllHcHhNSzR3LzUxdXM5a2lIdm5FYTBUS3NxV05TQ1E3dDFMOG4K",
      "endpoints": [
        "https://github.com/Mun1to/Adeorq-releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "macOS": {
      "hardenedRuntime": true,
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist",
      "files": {
        "Resources/en.lproj/InfoPlist.strings": "macos/en.lproj/InfoPlist.strings",
        "Resources/es.lproj/InfoPlist.strings": "macos/es.lproj/InfoPlist.strings"
      }
    },
    "linux": {
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "libappindicator-gtk3",
          "librsvg2"
        ]
      }
    },
    "resources": {
      "../docs/GUIA.md": "docs/GUIA.md",
      "../docs/GUIDE.en.md": "docs/GUIDE.en.md",
      "../LICENSE": "LICENSE",
      "../NOTICE.md": "NOTICE.md",
      "../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md"
    },
    "copyright": "Copyright (c) 2026 Munir Torres Athayde",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
