# Build output and local tooling state
node_modules/
dist/
.wrangler/

# La portada inglesa: la genera scripts/hacer-ingles.mjs desde index.html en
# cada build. Versionarla sería tener dos fuentes del mismo texto.
# Con la barra delante: solo la de la raíz de la web. Sin ella se llevaba
# también `assets/screens/en/`, que son las capturas en inglés y sí se versionan.
/en/

# Local secrets (never commit)
.dev.vars
.froede-token

# Las dos páginas de privacidad: las genera scripts/hacer-privacidad.mjs desde legal/ en cada
# build. La inglesa (en/privacy.html) ya cae dentro de /en/, más arriba.
/privacidad.html

# Las páginas por búsqueda: las genera scripts/hacer-paginas.mjs desde paginas/ en cada
# build. Las inglesas ya caen dentro de /en/, más arriba.
/claude-code-windows.html
/claude-code-codex-gemini.html
/comparativa.html
/novedades.html
