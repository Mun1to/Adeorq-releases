{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and the torn-off terminals",
  "windows": [
    "main",
    "suelta-*"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "updater:default",
    "process:default",
    "notification:default",
    "core:window:allow-request-user-attention",
    "dialog:default"
  ]
}
