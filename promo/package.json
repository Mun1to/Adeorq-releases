{
  "name": "adeorq-promo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "El video de promocion de Adeorq. Fuera del workspace a proposito: Remotion arrastra un Chrome headless y no tiene por que instalarse al clonar el producto. Se instala aqui dentro con `pnpm install --ignore-workspace`.",
  "scripts": {
    "capturas": "node capturas.mjs",
    "guion": "node guion-voz.mjs",
    "voz": "node voz.mjs",
    "sonido": "node sonido.mjs",
    "tipos": "tsc --noEmit",
    "ver": "node sonido.mjs && remotion studio src/index.ts",
    "render": "node render.mjs Promo",
    "media": "node render.mjs Media",
    "muestra": "node render.mjs Transiciones",
    "vertical": "node render.mjs Vertical",
    "corta": "node render.mjs Corta",
    "gif": "node render.mjs Corta gif"
  },
  "dependencies": {
    "@remotion/cli": "4.0.507",
    "@remotion/fonts": "4.0.507",
    "@remotion/transitions": "4.0.507",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remotion": "4.0.507"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "typescript": "~5.8.3"
  }
}
